# Ascassy backend — environment template
# Copy to .env and fill in real values. NEVER commit the real .env.

# Runtime
NODE_ENV=development
PORT=4000

# Allowed CORS origin(s) — comma-separated. Use the frontend dev URL locally,
# and https://ascassy.com (plus any preview domains) in production.
CORS_ORIGIN=http://localhost:5173

# Rate limiting — per IP, per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# Inquiry recipient — where contact/demo submissions are emailed.
INQUIRY_TO_EMAIL=hello@ascassy.com
INQUIRY_FROM_EMAIL=no-reply@ascassy.com

# Email transport (SMTP). Leave SMTP_HOST blank to disable email sending —
# the server will then log inquiries to the console (useful for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
