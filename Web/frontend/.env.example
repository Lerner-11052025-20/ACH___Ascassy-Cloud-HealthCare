# Ascassy frontend — environment template
# Copy to .env (or .env.local) and adjust. Never commit the real .env.

# Backend API base URL. Defaults to http://localhost:4000 when unset.
# Production: https://api.ascassy.com (or wherever the backend is hosted).
VITE_API_BASE_URL=http://localhost:4000

# Public site URL used in canonical links and the sitemap.
VITE_SITE_URL=http://localhost:5173
